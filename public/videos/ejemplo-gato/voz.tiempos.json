{
 "duracion": 97.56,
 "capitulos": [
  {
   "titulo": "Si tu gato te mira mientras duermes",
   "ini": 0.0
  },
  {
   "titulo": "Archivo cero diecisiete",
   "ini": 28.36
  },
  {
   "titulo": "Regla uno",
   "ini": 40.96
  },
  {
   "titulo": "Regla dos",
   "ini": 71.4
  }
 ],
 "frases": [
  {
   "texto": "Son las tres y cuatro minutos de la madrugada.",
   "ini": 0.0,
   "fin": 2.56
  },
  {
   "texto": "Te despiertas sin saber por qué.",
   "ini": 3.2,
   "fin": 5.2
  },
  {
   "texto": "La casa está en silencio.",
   "ini": 5.52,
   "fin": 7.04
  },
  {
   "texto": "Y a los pies de tu cama…",
   "ini": 7.6,
   "fin": 9.36
  },
  {
   "texto": "hay dos puntos amarillos.",
   "ini": 9.44,
   "fin": 10.96
  },
  {
   "texto": "Es tu gato.",
   "ini": 11.68,
   "fin": 12.4
  },
  {
   "texto": "Está sentado.",
   "ini": 12.88,
   "fin": 14.0
  },
  {
   "texto": "Muy quieto.",
   "ini": 14.32,
   "fin": 15.36
  },
  {
   "texto": "Mirándote.",
   "ini": 15.68,
   "fin": 16.4
  },
  {
   "texto": "Si esto te ha pasado alguna vez, este archivo es para ti.",
   "ini": 17.28,
   "fin": 20.92
  },
  {
   "texto": "No enciendas la luz.",
   "ini": 21.28,
   "fin": 22.64
  },
  {
   "texto": "No digas nada.",
   "ini": 22.88,
   "fin": 23.84
  },
  {
   "texto": "Y sobre todo…",
   "ini": 24.24,
   "fin": 25.52
  },
  {
   "texto": "no le preguntes qué quiere.",
   "ini": 25.68,
   "fin": 27.36
  },
  {
   "texto": "Archivo cero diecisiete.",
   "ini": 28.36,
   "fin": 30.44
  },
  {
   "texto": "Felino doméstico.",
   "ini": 30.52,
   "fin": 31.88
  },
  {
   "texto": "Negociado de Asuntos Nocturnos.",
   "ini": 31.96,
   "fin": 34.12
  },
  {
   "texto": "Hay siete reglas.",
   "ini": 34.36,
   "fin": 35.76
  },
  {
   "texto": "Casi todos los dueños de gatos ya cumplen seis…",
   "ini": 35.96,
   "fin": 39.08
  },
  {
   "texto": "sin saberlo.",
   "ini": 39.16,
   "fin": 39.96
  },
  {
   "texto": "Regla número uno.",
   "ini": 40.96,
   "fin": 42.24
  },
  {
   "texto": "No enciendas la luz.",
   "ini": 42.8,
   "fin": 44.08
  },
  {
   "texto": "Tu gato ve con seis veces menos luz que tú.",
   "ini": 44.56,
   "fin": 47.6
  },
  {
   "texto": "A oscuras, él ve tu cara perfectamente.",
   "ini": 47.64,
   "fin": 50.16
  },
  {
   "texto": "Tú solo ves sus ojos.",
   "ini": 50.64,
   "fin": 52.08
  },
  {
   "texto": "Si enciendes la luz, la cosa se iguala.",
   "ini": 52.64,
   "fin": 55.12
  },
  {
   "texto": "Y a él no le gusta que la cosa se iguale.",
   "ini": 55.36,
   "fin": 57.68
  },
  {
   "texto": "Sus ojos brillan porque tienen una capa como un espejo detrás.",
   "ini": 58.24,
   "fin": 61.96
  },
  {
   "texto": "Devuelve la luz.",
   "ini": 62.24,
   "fin": 63.2
  },
  {
   "texto": "Por eso parecen dos linternas.",
   "ini": 63.68,
   "fin": 65.44
  },
  {
   "texto": "No son linternas.",
   "ini": 65.92,
   "fin": 67.24
  },
  {
   "texto": "Son ventanas.",
   "ini": 67.44,
   "fin": 68.68
  },
  {
   "texto": "Y él está detrás.",
   "ini": 68.88,
   "fin": 70.4
  },
  {
   "texto": "Regla número dos.",
   "ini": 71.4,
   "fin": 72.68
  },
  {
   "texto": "Si te mira fijamente…",
   "ini": 73.16,
   "fin": 74.52
  },
  {
   "texto": "parpadea despacio.",
   "ini": 75.08,
   "fin": 76.28
  },
  {
   "texto": "Cierra los ojos.",
   "ini": 76.76,
   "fin": 77.72
  },
  {
   "texto": "Cuenta hasta dos.",
   "ini": 78.2,
   "fin": 79.16
  },
  {
   "texto": "Ábrelos.",
   "ini": 79.64,
   "fin": 80.52
  },
  {
   "texto": "Esto no es un truco del archivo.",
   "ini": 80.84,
   "fin": 82.6
  },
  {
   "texto": "Un estudio de dos mil veinte lo comprobó.",
   "ini": 83.0,
   "fin": 85.0
  },
  {
   "texto": "Para un gato, el parpadeo lento es una señal de confianza.",
   "ini": 85.48,
   "fin": 88.84
  },
  {
   "texto": "Si tu gato te devuelve el parpadeo, has pasado la noche.",
   "ini": 89.4,
   "fin": 92.72
  },
  {
   "texto": "Si no lo hace…",
   "ini": 93.0,
   "fin": 94.36
  },
  {
   "texto": "vuelve a intentarlo.",
   "ini": 94.44,
   "fin": 95.64
  },
  {
   "texto": "Y no apartes la mirada.",
   "ini": 95.88,
   "fin": 97.64
  }
 ],
